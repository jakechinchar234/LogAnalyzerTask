# ui/run_analysis_page.py
import threading
import tkinter as tk
from tkinter import ttk, filedialog, messagebox

from profile_manager import load_profile
from analyzer_backend import _normalize_atcs, to_dotted_atcs_format, load_location_excel_mapping


class ProgressDialog(tk.Toplevel):
    def __init__(self, parent, title="Working...", message="Please wait..."):
        super().__init__(parent)
        self.title(title)
        self.configure(bg="#4a4a4a")
        self.resizable(False, False)
        self.protocol("WM_DELETE_WINDOW", lambda: None)
        self.transient(parent)
        self.grab_set()

        tk.Label(self, text=message, fg="white", bg="#4a4a4a").pack(
            padx=18, pady=(14, 8)
        )
        self.pb = ttk.Progressbar(self, mode="indeterminate", length=260)
        self.pb.pack(padx=18, pady=(0, 14))
        self.pb.start(10)

        self.update_idletasks()
        x = parent.winfo_rootx() + (parent.winfo_width() // 2 - self.winfo_width() // 2)
        y = parent.winfo_rooty() + (parent.winfo_height() // 2 - self.winfo_height() // 2)
        self.geometry(f"+{x}+{y}")


class RunAnalysisPage(tk.Frame):
    def __init__(self, parent, controller):
        super().__init__(parent, bg="#4a4a4a")
        self.controller = controller

        tk.Label(self, text="Run Analysis", font=("Arial", 20, "bold"), fg="white", bg="#4a4a4a").pack(anchor="w")

        card = tk.Frame(self, bg="#4a4a4a")
        card.pack(fill="both", expand=True, padx=4, pady=4)

        form = tk.Frame(card, bg="#4a4a4a")
        form.grid(row=0, column=0, sticky="nsew", padx=16, pady=16)

        self.fields = {}
        row = 0

        def add_file(label, key, filetypes):
            nonlocal row
            tk.Label(form, text=label, fg="white", bg="#4a4a4a").grid(
                row=row, column=0, sticky="w", pady=4
            )
            e = ttk.Entry(form, width=56)
            e.grid(row=row, column=1, sticky="w", pady=4)
            ttk.Button(
                form, text="Browse", command=lambda: self._browse_into(e, filetypes)
            ).grid(row=row, column=2, padx=(8, 0))
            self.fields[key] = e
            row += 1

        add_file("IXL Text File", "ixl_file", [("Text", "*.txt"), ("All", "*.*")])
        add_file("CM Log Text File", "cm_log_file", [("Text", "*.txt"), ("All", "*.*")])
        add_file("Wireshark PCAP File", "pcap_file", [("PCAP", "*.pcap"), ("All", "*.*")])
        add_file(
            "Packetswitch File",
            "packetswitch_file",
            [("HTML", "*.html"), ("DOCX", "*.docx"), ("All", "*.*")],
        )
        add_file("Office File", "office_file",[("Text/HTML Files", "*.txt *.html"),("Text", "*.txt"),("HTML", "*.html"),("All", "*.*")])
        add_file("Component Excel File", "ixl_excel_file", [("Excel", "*.xlsx"), ("All", "*.*")])
        add_file("Location Excel File", "location_excel_file", [("Excel",".xlsx"), ("All", "*.*")])


        tk.Label(form, text="Filename Suffix:", fg="white", bg="#4a4a4a").grid(
            row=row, column=0, sticky="w", pady=4
        )
        self.suffix_entry = ttk.Entry(form, width=56)
        self.suffix_entry.grid(row=row, column=1, sticky="w", pady=8)
        row +=1

        tk.Label(form, text="Target Address", fg="white", bg="#4a4a4a").grid(
            row=row, column=0, sticky="w", pady=4
        )
        self.addr_combo = ttk.Combobox(form, width=24, state="normal")
        self.addr_combo.grid(row=row, column=1, sticky="w", pady=4)
        ttk.Button(form, text="Scan Addresses & Time", command=self._scan_pcap_metadata).grid(
            row=row, column=2, padx=(8, 0)
        )
        row += 1

        tk.Label(form, text="Start Time (HH:MM:SS.sss)", fg="white", bg="#4a4a4a") \
            .grid(row=row, column=0, sticky="w", pady=4)
        self.start_time_entry = ttk.Entry(form, width=24)
        self.start_time_entry.grid(row=row, column=1, sticky="w", pady=4)
        row += 1

        tk.Label(form, text="End Time (HH:MM:SS.sss)", fg="white", bg="#4a4a4a") \
            .grid(row=row, column=0, sticky="w", pady=4)
        self.end_time_entry = ttk.Entry(form, width=24)
        self.end_time_entry.grid(row=row, column=1, sticky="w", pady=4)
        row += 1

        ttk.Button(
            card, text="Run Analysis", command=self._run
        ).grid(row=1, column=0, sticky="w", padx=16, pady=(0, 16))


    def _browse_into(self, entry, filetypes):
        path = filedialog.askopenfilename(title="Select file", filetypes=filetypes)
        if path:
            entry.delete(0, tk.END)
            entry.insert(0, path)

    def _scan_pcap_metadata(self):
        pcap_entry = self.fields.get("pcap_file")
        if not pcap_entry:
            messagebox.showerror("Error", "PCAP field not found.")
            return

        pcap_path = pcap_entry.get().strip()
        if not pcap_path:
            messagebox.showerror("Error", "Please select a PCAP file first.")
            return

        dlg = ProgressDialog(
            self,
            title="Scanning PCAP",
            message="Scanning PCAP for addresses and time range..."
        )

        def worker():
            try:
                from analyzer_backend import (
                    collect_atcs_addresses_starting_with7,
                    to_dotted_atcs_format,
                    find_pcap_time_bounds,
                )

                raw_addrs = collect_atcs_addresses_starting_with7(pcap_path)
                print("RAW ADDRS:", raw_addrs)

                # Load Excel mapping
                location_excel_path = self.fields["location_excel_file"].get().strip()
                excel_map = load_location_excel_mapping(location_excel_path)

                # Dropdown
                dropdown_values = []
                seen = set()

                for addr in raw_addrs:
                    # Convert to dotted
                    dotted = to_dotted_atcs_format(addr)
                    if not dotted:
                        continue

                    # Normalize for matching
                    norm = _normalize_atcs(dotted)

                    # Excel match (source of truth)
                    if norm in excel_map:
                        display = excel_map[norm]
                    else:
                        display = dotted

                    # Deduplicate
                    if display not in seen:
                        seen.add(display)
                        dropdown_values.append(display)

                print("FINAL DROPDOWN:", dropdown_values)
            
                # ---- Time bounds scan ----
                start_time, end_time = find_pcap_time_bounds(pcap_path)

            except Exception as e:
                start_time = end_time = None
                err = str(e)
                print("SCAN ERROR:", err)
            else:
                err = None

            def done():
                try:
                    if err:
                        messagebox.showerror(
                            "Error",
                            f"Failed to scan PCAP:\n{err}"
                        )
                        return
                    
                    current_addr = self.addr_combo.get()
                    self.addr_combo["values"] = dropdown_values
                    self.addr_combo.set(current_addr)

                    if start_time:
                        self.start_time_entry.delete(0, tk.END)
                        self.start_time_entry.insert(0, start_time)

                    if end_time:
                        self.end_time_entry.delete(0, tk.END)
                        self.end_time_entry.insert(0, end_time)

                finally:
                    dlg.destroy()

            self.after(0, done)

        threading.Thread(target=worker, daemon=True).start()
    
    def _auto_fill_times_async(self):
        pcap_entry = self.fields.get("pcap_file")
        if not pcap_entry:
            messagebox.showerror("Error", "PCAP field not found.")
            return

        pcap_path = pcap_entry.get().strip()
        if not pcap_path:
            messagebox.showerror("Error", "Please select a PCAP file first.")
            return

        dlg = ProgressDialog(
            self,
            title="Scanning PCAP",
            message="Scanning PCAP for start/end timestamps..."
        )

        def worker():
            try:
                from analyzer_backend import find_pcap_time_bounds
                start, end = find_pcap_time_bounds(pcap_path)
            except Exception as e:
                start = end = None
                err = str(e)
            else:
                err = None

            def done():
                if err:
                    messagebox.showerror(
                        "Error",
                        f"Failed to scan PCAP time range:\n{err}"
                    )
                else:
                    if start:
                        self.start_time_entry.delete(0, tk.END)
                        self.start_time_entry.insert(0, start)
                    if end:
                        self.end_time_entry.delete(0, tk.END)
                        self.end_time_entry.insert(0, end)
                dlg.destroy()

            # SWITCH UI updates back to main thread
            self.after(0, done)

        threading.Thread(target=worker, daemon=True).start()


    def load_profile(self, name):
        try:
            data = load_profile(name)
        except Exception as e:
            messagebox.showerror(
                "Error",
                f"Failed to load profile '{name}':\n{e}"
            )
            return

        def setf(key, val):
            w = self.fields.get(key)
            if w is not None:
                w.delete(0, tk.END)
                if val:
                    w.insert(0, val)

        # File paths
        setf("ixl_file", data.get("ixl_file"))
        setf("cm_log_file", data.get("cm_log_file"))
        setf("pcap_file", data.get("pcap_file"))
        setf("packetswitch_file", data.get("packetswitch_file"))
        setf("ixl_excel_file", data.get("ixl_excel_file"))
        setf("location_excel_file", data.get("location_excel_file"))
        
        self.profile_suffix = data.get("output_suffix", "")
        self.suffix_entry.delete(0, tk.END)
        self.suffix_entry.insert(0, self.profile_suffix)

        # Target address
        dotted = data.get("target_address_dotted") or ""
        self.addr_combo.set(dotted)


    # ---------------- run analysis ----------------

    def _run(self):
        from analyzer_backend import analyze_logs, resolve_user_input_to_hex, load_location_excel_mapping

        params = {k: w.get().strip() for k, w in self.fields.items()}

        addr_text = self.addr_combo.get().strip()
        excel_map = load_location_excel_mapping(
            self.fields.get("location_excel_file").get().strip()
        )
        raw = resolve_user_input_to_hex(addr_text, excel_map)
        if not raw or len(raw) % 2 != 0:
            messagebox.showerror(
                "Error",
                "Invalid ATCS address or location name."
            )
            return

        try:
            addr_bytes = bytes.fromhex(raw)
        except Exception:
            messagebox.showerror("Error", "Invalid target address.")
            return

        dlg = ProgressDialog(self, title="Running Analysis", message="Processing logs...")

        def worker():
            try:
                start_time = self.start_time_entry.get().strip()
                end_time = self.end_time_entry.get().strip()
                suffix = self.suffix_entry.get().strip()
                if not suffix:
                    suffix = getattr(self, "profile_suffix", "")

                analyze_logs(
                    params.get("ixl_file") or False,
                    params.get("cm_log_file") or False,
                    params.get("pcap_file"),
                    params.get("ixl_excel_file") or False,
                    start_time,
                    end_time,
                    params.get("packetswitch_file") or "",
                    params.get("office_file") or "",
                    addr_bytes,
                    suffix,
                )
            except Exception as e:
                messagebox.showerror("Error", f"Analysis failed:\n{e}")
            finally:
                self.after(0, dlg.destroy)

        threading.Thread(target=worker, daemon=True).start()
